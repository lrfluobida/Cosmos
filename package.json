{
  "name": "cosmos-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.22.2 <23" },
  "bin": { "cosmos": "dist/cli/index.js" },
  "scripts": {
    "start": "node --experimental-strip-types src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\" \"tests/**/*.test.mjs\"",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "typebox": "1.3.27"
  }
}
