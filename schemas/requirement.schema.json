{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmos.local/contracts/1.0.0/requirement.schema.json",
  "title": "Cosmos requirement contract 1.0.0",
  "$comment": "Structural validation only; apply src/contracts semantic and update validators before accepting a record.",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "specVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "confirmedBy": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "confirmedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/artifactReference"
      },
      "minItems": 1
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "acceptanceId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidenceKinds": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/evidenceKind"
            },
            "minItems": 1
          }
        },
        "required": [
          "acceptanceId",
          "description",
          "steps",
          "expected",
          "evidenceKinds"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "contractVersion",
    "specVersion",
    "confirmedBy",
    "confirmedAt",
    "sources",
    "acceptance"
  ],
  "additionalProperties": false
}
