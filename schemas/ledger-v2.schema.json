{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmos.local/contracts/2.0.0/ledger.schema.json",
  "title": "Cosmos continuation ledger contract 2.0.0",
  "$comment": "Structural validation only. Original limit and allocations remain immutable. Semantic validation enforces exact closure release and the cumulative authorized cap.",
  "type": "object",
  "properties": {
    "contractVersion": { "const": "2.0.0" },
    "ledgerId": { "$ref": "ledger.schema.json#/properties/ledgerId" },
    "scope": { "const": "generation" },
    "limitMicroCny": { "$ref": "common.schema.json#/$defs/money" },
    "warningThresholdPercent": { "const": 80 },
    "allocations": { "$ref": "ledger.schema.json#/properties/allocations" },
    "entries": { "$ref": "ledger.schema.json#/properties/entries" },
    "authorizations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "decisionId": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "windowId": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "additionalMicroCny": { "$ref": "common.schema.json#/$defs/money" }
        },
        "required": ["decisionId", "windowId", "additionalMicroCny"],
        "additionalProperties": false
      }
    },
    "allocationClosures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "taskId": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "decisionId": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "releasedMicroCny": { "$ref": "common.schema.json#/$defs/money" }
        },
        "required": ["taskId", "decisionId", "releasedMicroCny"],
        "additionalProperties": false
      }
    }
  },
  "required": ["contractVersion", "ledgerId", "scope", "limitMicroCny", "warningThresholdPercent", "allocations", "entries", "authorizations", "allocationClosures"],
  "additionalProperties": false
}
